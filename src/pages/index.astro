---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KeyboardIntro from '../components/KeyboardIntro.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://adamlevente.hu/#person',
  name: 'Ádám Levente Dániel',
  jobTitle: 'Software Developer and Tester',
  description:
    'Final-year software development and testing student – frontend, backend, databases, deployment.',
  url: 'https://adamlevente.hu',
  knowsAbout: [
    'Web development',
    'Software testing',
    'JavaScript',
    'Python',
    'Java',
    'Supabase',
    'Vercel',
  ],
  sameAs: [],
};
---

<Layout
  title="Ádám Levente Dániel – Software Developer & Tester"
  description="Final-year software developer and tester – frontend, backend, databases, deployment. Modern technologies, real project experience."
  canonical="https://adamlevente.hu/"
  schema={personSchema}
>
  <Header />
  <main>
    <KeyboardIntro />
    <Hero />
    <About />
    <Skills />
    <Experience />
  </main>
  <Footer />
</Layout>
