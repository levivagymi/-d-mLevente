---
// Work and school as a dated list, then "First steps": the practice projects, oldest first.
import SectionHeader from '../ui/SectionHeader.astro';
import KeycapBadge from '../ui/KeycapBadge.astro';
import TextLink from '../ui/TextLink.astro';
import { experience, education, firstSteps, type TimelineEntry } from '../../data/profile';

const groups: { title: string; entries: TimelineEntry[] }[] = [
  { title: 'Work', entries: experience },
  { title: 'Education', entries: education },
];
---

<section id="experience" aria-labelledby="experience-heading" class="mx-auto w-full max-w-page px-4 pb-18 sm:px-8 sm:pb-28">
  <SectionHeader section="experience" headingId="experience-heading">Experience &amp; education</SectionHeader>

  <div class="mt-12 grid gap-12">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-mono text-label uppercase text-muted">{group.title}</h3>
          <ol class="mt-4 border-t border-line">
            {group.entries.map((entry) => (
              <li class="grid gap-1 border-b border-line py-5 md:grid-cols-12 md:gap-6">
                <span class="pt-[0.2rem] font-mono text-label uppercase text-muted md:col-span-3">{entry.period}</span>
                <div class="md:col-span-9">
                  <p class="text-body font-bold text-fg">
                    {entry.title} <span class="font-normal text-fg-soft">· {entry.org}</span>
                  </p>
                  <p class="mt-1 max-w-measure text-body text-fg-soft">{entry.summary}</p>
                  {entry.href && (
                    <p class="mt-2">
                      <TextLink href={entry.href}>Case study ↑</TextLink>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <div id="first-steps" class="mt-16">
    <h3 class="flex items-center gap-3 text-h3 text-fg"><KeycapBadge id="F" /> First steps</h3>
    <p class="mt-3 max-w-measure text-body text-fg-soft">The practice and school projects I learned on, oldest first.</p>
    <ol class="mt-6 grid gap-4 md:grid-cols-3">
      {
        firstSteps.map((step) => (
          <li class="flex flex-col rounded-lg border border-line bg-surface p-5">
            <span class="font-mono text-label uppercase text-muted">{step.period}</span>
            <h4 class="mt-2 text-lg tracking-[-0.02em] text-fg">{step.title}</h4>
            <p class="mt-2 text-body text-fg-soft">{step.summary}</p>
            <p class="mt-4 font-mono text-label uppercase text-muted">{step.stack.join(' · ')}</p>
            <p class="mt-auto flex gap-5 pt-4">
              {step.links.map((link) => (
                <TextLink href={link.href} external>
                  {link.label}
                </TextLink>
              ))}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
