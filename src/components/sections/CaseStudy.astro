---
// One featured project: meta on the left, the case (problem → built → result → testing) on the right.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import TextLink from '../ui/TextLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, kind, status, period, role, problem, built, result, testing, stack, links, image, imageAlt } = project.data;

const kindLabel = { client: 'Client', school: 'School', personal: 'Personal' }[kind];
const statusLabel = { live: 'Live', 'pre-launch': 'Pre-launch', 'in-progress': 'In progress' }[status];
const headingId = `project-${project.id}-title`;

const rows: { label: string; text?: string; items?: string[] }[] = [
  { label: 'Problem', text: problem },
  { label: 'Built', items: built },
  { label: 'Result', items: result },
  ...(testing ? [{ label: 'Testing', text: testing }] : []),
];
---

<article
  id={`project-${project.id}`}
  aria-labelledby={headingId}
  class="grid gap-8 rounded-lg border border-line bg-surface p-5 sm:p-8 lg:grid-cols-12 lg:gap-10"
>
  <header class="lg:col-span-4">
    <p class="font-mono text-label text-muted">{String(index).padStart(2, '0')}</p>
    <h3 id={headingId} class="mt-3 text-h3 text-fg">{title}</h3>
    <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-label uppercase text-muted">
      <span>{kindLabel}</span><span aria-hidden="true">·</span><span>{period}</span><span aria-hidden="true">·</span>
      <span class:list={['inline-flex items-center gap-1.5', status === 'live' ? 'text-ok' : 'text-fg-soft']}>
        {status === 'live' && <span class="size-1.5 rounded-full bg-ok" aria-hidden="true" />}
        {statusLabel}
      </span>
    </p>
    <p class="mt-4 text-small text-fg-soft">{role}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack">
      {stack.map((item) => <li class="rounded border border-line px-2 py-0.5 font-mono text-label text-fg-soft">{item}</li>)}
    </ul>
    {
      (links.live || links.code) && (
        <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {links.live && <TextLink href={links.live} external>Live site</TextLink>}
          {links.code && <TextLink href={links.code} external>Code</TextLink>}
        </p>
      )
    }
  </header>

  <div class="lg:col-span-8">
    {
      image && (
        <Image
          src={image}
          alt={imageAlt ?? `${title}, home page`}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 720px, 100vw"
          class="mb-6 aspect-[16/10] w-full rounded-md border border-line object-cover object-top"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <dl class="border-t border-line">
      {
        rows.map((row) => (
          <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[7.5rem_1fr] sm:gap-4">
            <dt class="pt-[0.2rem] font-mono text-label uppercase text-muted">{row.label}</dt>
            <dd class="text-body text-fg">
              {row.text}
              {row.items && (
                <ul class="grid gap-1.5">
                  {row.items.map((item) => (
                    <li class="relative pl-4 before:absolute before:left-0 before:text-muted before:content-['–']">{item}</li>
                  ))}
                </ul>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</article>
