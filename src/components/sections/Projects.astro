---
// Featured case studies first, then the smaller projects as one-line rows.
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import TextLink from '../ui/TextLink.astro';
import CaseStudy from './CaseStudy.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const more = projects.filter((project) => !project.data.featured);
---

<section id="projects" aria-labelledby="projects-heading" class="mx-auto w-full max-w-page px-4 pb-18 sm:px-8 sm:pb-28">
  <SectionHeader section="projects" headingId="projects-heading">Selected work</SectionHeader>
  <p class="mt-6 max-w-measure text-lead text-fg-soft">
    Two client sites and a class project. Each one answers the same questions: what was the problem, what I built, and what
    came of it.
  </p>

  <ol class="mt-12 grid gap-6">
    {
      featured.map((project, index) => (
        <li>
          <CaseStudy project={project} index={index + 1} />
        </li>
      ))
    }
  </ol>

  {
    more.length > 0 && (
      <>
        <h3 class="mt-16 font-mono text-label uppercase text-muted">More projects</h3>
        <ul class="mt-4 border-t border-line">
          {more.map((project) => (
            <li id={`project-${project.id}`} class="grid gap-2 border-b border-line py-5 md:grid-cols-12 md:items-baseline md:gap-6">
              <span class="font-bold text-fg md:col-span-3">{project.data.title}</span>
              <span class="text-fg-soft md:col-span-5">{project.data.summary}</span>
              <span class="font-mono text-label uppercase text-muted md:col-span-2">{project.data.stack.join(' · ')}</span>
              <span class="flex gap-5 md:col-span-2 md:justify-end">
                {project.data.links.live && <TextLink href={project.data.links.live} external>Live</TextLink>}
                {project.data.links.code && <TextLink href={project.data.links.code} external>Code</TextLink>}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
