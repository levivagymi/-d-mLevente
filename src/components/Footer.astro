---
// The bottom of the ink band. "Updated" is the build month, so the date can't go stale while the site is maintained.
import { person } from '../data/profile';

const built = new Date();
const year = built.getFullYear();
const month = built.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<footer class="site-footer band bg-inv text-inv-muted">
  <div class="mx-auto w-full max-w-page px-4 pb-8 sm:px-8">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-1 border-t border-inv-line pt-4 font-mono text-label uppercase">
      <p class="sm:flex-1">&copy; {year} {person.name}</p>
      <p>Updated <time datetime={built.toISOString().slice(0, 7)}>{month}</time></p>
      <p>
        <a href="#intro" class="inline-flex min-h-11 items-center text-inv-fg transition-colors duration-150 ease-out hover:text-inv-accent">
          Back to top ↑
        </a>
      </p>
    </div>
  </div>
</footer>
