---
// Sticky bar that sits over the intro, so the status and the main call to action are on screen from the first second.
// Height stays 64px + 1px rule: the intro sizes itself to the viewport minus 4rem.
import Button from './ui/Button.astro';
import { navSections, pageSections } from '../data/sections';
import { person, status, mailto } from '../data/profile';
import { cv } from '../data/cv';

const observed = ['intro', ...pageSections.map((section) => section.id)];
---

<header class="site-header sticky top-0 z-50 border-b border-line bg-page" data-observe={observed.join(' ')}>
  <div class="mx-auto flex h-16 w-full max-w-page items-center gap-3 px-4 sm:gap-4 sm:px-8">
    <a href="#intro" class="mr-auto font-sans text-base font-extrabold tracking-[-0.02em] text-fg hover:text-fg">
      {person.shortName}
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center">
        {
          navSections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="nav-link relative inline-flex min-h-11 items-center px-3 text-small font-semibold text-fg-soft transition-colors duration-150 ease-out hover:text-fg"
                data-nav={section.id}
              >
                {section.nav}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="flex items-center gap-2 font-mono text-label uppercase text-ok">
      <span class="size-2 shrink-0 rounded-full bg-ok" aria-hidden="true"></span>
      <span class="sr-only lg:not-sr-only xl:hidden">{status.chipShort}</span>
      <span class="hidden xl:inline">{status.chip}</span>
    </p>

    {
      cv ? (
        <Button href={cv.href} download={cv.fileName} class="min-h-11 px-4">
          CV (PDF)
        </Button>
      ) : (
        <Button href={mailto('Internship – Ádám Levente')} class="min-h-11 px-4">
          Email me
        </Button>
      )
    }

    <button
      type="button"
      class="hidden size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-transparent text-fg transition-colors duration-150 ease-out hover:border-line-strong md:inline-flex"
      aria-label="Dark theme"
      aria-pressed="false"
      data-theme-toggle
    >
      <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>

    <button
      type="button"
      class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-transparent text-fg md:hidden"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
      data-menu-button
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div id="site-menu" class="site-menu absolute inset-x-0 top-full border-b border-line bg-page md:hidden">
    <nav aria-label="Main" class="mx-auto w-full max-w-page px-4 pb-4 pt-2 sm:px-8">
      <ul>
        {
          navSections.map((section) => (
            <li class="border-b border-line">
              <a href={`#${section.id}`} class="flex min-h-12 items-center text-body font-semibold text-fg hover:text-accent" data-nav={section.id}>
                {section.nav}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        class="mt-2 flex min-h-12 w-full cursor-pointer items-center justify-between bg-transparent text-body font-semibold text-fg"
        aria-pressed="false"
        data-theme-toggle
      >
        Dark theme
        <span class="font-mono text-label uppercase text-muted" data-theme-state>Off</span>
      </button>
    </nav>
  </div>
</header>

<style>
  /* Active section: a 2px accent rule that draws in from the left. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem 0.35rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 150ms ease-out;
  }
  .nav-link[aria-current='true'] {
    color: var(--fg);
  }
  .nav-link[aria-current='true']::after {
    transform: scaleX(1);
  }

  .theme-icon-moon,
  :global([data-theme='dark']) .theme-icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-icon-moon {
    display: block;
  }

  /* Two bars that turn into a cross. */
  .menu-icon {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 160ms ease-out;
  }
  [aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Hidden menus leave the tab order through `visibility`, which waits for the fade to finish. */
  .site-menu {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out,
      visibility 0s linear 160ms;
  }
  .site-menu[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out;
  }
</style>

<script>
  const root = document.documentElement;

  // Theme: the inline script in Layout sets data-theme before paint; without storage the OS preference stands.
  const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;

  function syncThemeToggles() {
    const dark = isDark();
    for (const toggle of themeToggles) {
      toggle.setAttribute('aria-pressed', String(dark));
      const state = toggle.querySelector('[data-theme-state]');
      if (state) state.textContent = dark ? 'On' : 'Off';
    }
  }

  for (const toggle of themeToggles) {
    toggle.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (error) {
        console.info('Theme choice applies to this visit only: storage is unavailable.', error);
      }
      syncThemeToggles();
    });
  }
  syncThemeToggles();

  // Mobile menu: a disclosure under the bar. Escape and outside clicks close it.
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('site-menu');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (menuButton && menu && header) {
    const isOpen = () => menuButton.getAttribute('aria-expanded') === 'true';
    const setMenu = (open: boolean, restoreFocus = false) => {
      menu.toggleAttribute('data-open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (!open && restoreFocus) menuButton.focus();
    };

    menuButton.addEventListener('click', () => setMenu(!isOpen()));
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setMenu(false, true);
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && event.target instanceof Node && !header.contains(event.target)) setMenu(false);
    });
  }

  // Current section: whichever one crosses the middle of the viewport; the intro and sections outside the nav clear it.
  if (header) {
    const ids = (header.dataset.observe ?? '').split(' ').filter(Boolean);
    const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

    const observer = new IntersectionObserver(
      (entries) => {
        const current = entries.find((entry) => entry.isIntersecting)?.target.id;
        if (!current) return;
        for (const link of navLinks) {
          if (link.dataset.nav === current) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    for (const target of targets) observer.observe(target);
  }
</script>
