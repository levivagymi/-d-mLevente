          <div class="about__item">
            <span class="about__item-icon">–</span>Functional and manual testing
          </div>
          <div class="about__item">
            <span class="about__item-icon">–</span>Database management (SQL)
          </div>
          <div class="about__item">
            <span class="about__item-icon">–</span>Version control (Git)
          </div>
          <div class="about__item">
            <span class="about__item-icon">–</span>CI/CD and deployment (Vercel)
          </div>
          <div class="about__item">
            <span class="about__item-icon">–</span>Working with AI tools
          </div>
        </div>
      </div>
    </div>
  </div>
