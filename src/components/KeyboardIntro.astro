---
import { intro, keys, marquee, KEYBOARD_WIDTH, KEYBOARD_HEIGHT } from '../data/keyboard';

const summary = keys
  .filter((key) => key.kind === 'letter')
  .map((key) => `${key.legend} for ${key.term}`)
  .join(', ');

// Enter is painted first, so the bottom row (and the O sitting in its notch) stays in front of it.
const paintOrder = [...keys.filter((key) => key.kind === 'enter'), ...keys.filter((key) => key.kind === 'letter')];

// The ISO Enter outline in hundredths of a key unit, inside its 1.55u × 2u box: wide on top, narrower below.
const ENTER_SHELL = 'M20 3H135A17 17 0 0 1 152 20V180A17 17 0 0 1 135 197H64A17 17 0 0 1 47 180V113A8 8 0 0 0 39 105H20A17 17 0 0 1 3 88V20A17 17 0 0 1 20 3Z';
const ENTER_FACE = 'M23 6.5H132A13 13 0 0 1 145 19.5V164A13 13 0 0 1 132 177H67A13 13 0 0 1 54 164V91A6 6 0 0 0 48 85H23A13 13 0 0 1 10 72V19.5A13 13 0 0 1 23 6.5Z';
const ENTER_SOCKET = 'M24 10H131A14 14 0 0 1 145 24V176A14 14 0 0 1 131 190H68A14 14 0 0 1 54 176V102A4 4 0 0 0 50 98H24A14 14 0 0 1 10 84V24A14 14 0 0 1 24 10Z';
const ENTER_RING = 'M20 -3H135A23 23 0 0 1 158 20V180A23 23 0 0 1 135 203H64A23 23 0 0 1 41 180V113A2 2 0 0 0 39 111H20A23 23 0 0 1 -3 88V20A23 23 0 0 1 20 -3Z';
const ENTER_BEVELS = 'M11.5 84L5 102M55.5 176L49 194M143.5 176L150 194M52 88L45.5 106.5';
---

<section
  id="intro"
  class="kbi relative isolate overflow-hidden bg-stage text-stage-fg"
  aria-label="Portfolio intro"
  data-kbi
>
  <div class="mx-auto flex min-h-[calc(100svh-4rem)] w-full max-w-[1180px] flex-col px-4 pb-5 pt-8 sm:px-8 sm:pt-12">
    <!-- Headline: a greeting first, then what the pressed letter stands for -->
    <div>
      <h2 class="kbi-head m-0 text-stage-fg">
        <span class="kbi-slot" data-kbi-head>
          <span class="block">{intro.lead}</span>
          <span class="block">{intro.before}<em style="color:var(--color-stage-accent)">{intro.term}</em>{intro.after}</span>
        </span>
        <span class="kbi-slot invisible" data-kbi-head></span>
      </h2>
      <p class="kbi-story m-0 mt-4 max-w-[52ch] text-stage-fg/75" data-kbi-story>{intro.story}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-3">
        <button
          type="button"
          class="min-h-12 min-w-12 cursor-pointer rounded-full border border-stage-line bg-transparent px-4 font-sans text-base text-stage-fg transition-colors hover:border-stage-fg"
          aria-label="Previous letter"
          data-kbi-prev
        >
          ←
        </button>
        <button
          type="button"
          class="min-h-12 cursor-pointer rounded-full border border-stage-fg bg-transparent px-5 font-sans text-[0.95rem] font-semibold text-stage-fg transition-colors hover:bg-stage-fg hover:text-stage"
          data-kbi-next
        >
          Tell me more →
        </button>
        <a
          href="#main-content"
          class="kbi-jump min-h-12 rounded-full border border-stage-accent bg-stage-accent px-5 font-sans text-[0.95rem] font-semibold text-white transition-colors hover:border-stage-accent-strong hover:bg-stage-accent-strong hover:text-white"
          hidden
          data-kbi-jump
        >
          Jump<span class="hidden sm:inline">&nbsp;to <span data-kbi-jump-term></span></span>&nbsp;↓
        </a>
        <button
          type="button"
          class="min-h-12 cursor-pointer rounded-full border border-stage-accent bg-transparent px-4 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-stage-accent transition-colors hover:bg-stage-accent hover:text-white"
          hidden
          data-kbi-putback
        >
          Put back
        </button>
        <p class="m-0 ml-auto font-mono text-[0.7rem] uppercase leading-normal tracking-[0.14em] text-stage-muted">
          <span class="text-stage-fg" data-kbi-count>0</span>/{keys.length} explored ·
          <a
            href="#main-content"
            class="rounded-sm py-2 text-stage-fg underline decoration-stage-line underline-offset-4 transition-colors hover:text-stage-accent hover:decoration-stage-accent"
          >
            Skip intro ↓
          </a>
        </p>
      </div>
      <p class="sr-only" aria-live="polite" data-kbi-live></p>
    </div>

    <!-- Keyboard -->
    <div class="kbi-wrap">
      <div
        class="kbi-board"
        role="group"
        aria-label="PORTFOLIO keyboard: every letter stands for one part of my portfolio"
        aria-describedby="kbi-help"
        style={`--kw:${KEYBOARD_WIDTH};--kh:${KEYBOARD_HEIGHT}`}
        data-kbi-board
      >
        {paintOrder.map((key) => (
          <button
            type="button"
            class="kbi-key"
            tabindex={key.id === keys[0].id ? 0 : -1}
            aria-label={key.kind === 'enter' ? `Enter: ${key.sub}` : `${key.legend}: ${key.term}`}
            style={`--x:${key.x};--y:${key.y};--w:${key.w};--h:${key.h};--cap:${key.cap};--side:${key.side};--ink:${key.ink}`}
            data-key={key.id}
            data-enter={key.kind === 'enter' ? '' : undefined}
          >
            {key.kind === 'enter' && (
              <svg class="kbi-enter-socket" viewBox="0 0 155 200" aria-hidden="true">
                <path d={ENTER_SOCKET} />
              </svg>
            )}
            <span class="kbi-stem" aria-hidden="true"></span>
            <span class="kbi-shell" aria-hidden="true" data-shell>
              {key.kind === 'enter' && (
                <svg class="kbi-enter-body" viewBox="0 0 155 200">
                  <defs>
                    <linearGradient id="kbi-enter-side" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0.55" class="kbi-side-top" />
                      <stop offset="1" class="kbi-side-bottom" />
                    </linearGradient>
                  </defs>
                  <path class="kbi-enter-ring" d={ENTER_RING} />
                  <path class="kbi-enter-shape" d={ENTER_SHELL} fill="url(#kbi-enter-side)" />
                  <path class="kbi-enter-bevel" d={ENTER_BEVELS} />
                </svg>
              )}
              <span class="kbi-top" data-top>
                {key.kind === 'enter' ? (
                  <>
                    <svg class="kbi-enter-face" viewBox="10 6.5 135 170.5">
                      <path d={ENTER_FACE} />
                    </svg>
                    <svg class="kbi-enter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="square">
                      <path d="M19 4v8.5a1.5 1.5 0 0 1-1.5 1.5H6" />
                      <path d="M10 9.5 5.5 14l4.5 4.5" />
                    </svg>
                  </>
                ) : (
                  <span class="kbi-legend">{key.legend}</span>
                )}
                <span class="kbi-sub">{key.sub}</span>
              </span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Hint, replaced by tips as the visitor goes deeper -->
    <p class="m-0 text-center font-mono text-[0.72rem] leading-relaxed text-stage-muted" data-kbi-hint>
      <span class="pointer-coarse:hidden">Run your mouse across the keys · click one · or type “portfolio”.</span>
      <span class="hidden pointer-coarse:inline">Swipe your finger across the keys, or tap one.</span>
    </p>
    <p class="m-0 text-center font-mono text-[0.72rem] leading-relaxed text-stage-accent" hidden data-kbi-tip></p>

    <!-- Ticker -->
    <div class="kbi-marquee mt-5" aria-hidden="true">
      <div class="kbi-marquee-track">
        {[0, 1].map(() => (
          <span class="kbi-marquee-copy">
            {[...marquee, ...marquee].map((line) => <span>{line}</span>)}
          </span>
        ))}
      </div>
    </div>
    <p class="sr-only">{marquee.join('. ')}.</p>

    <p id="kbi-help" class="sr-only">
      Use the arrow keys to move between the letters and Enter or Space to press one. Each letter of PORTFOLIO stands
      for one part of my portfolio, and the “Jump” link takes you to it further down the page.
    </p>
    <noscript>
      <p class="m-0 mt-4 max-w-[60ch] text-stage-fg/80">PORTFOLIO: {summary}. Scroll down to explore them.</p>
    </noscript>
  </div>

  <div class="pointer-events-none absolute inset-0 z-10" aria-hidden="true" data-kbi-flylayer>
    {Array.from({ length: 6 }, () => <span class="kbi-fly"></span>)}
  </div>
</section>

<style>
  /* ---------- Headline ---------- */
  .kbi-head {
    display: grid;
    overflow: hidden;
    min-height: calc(3 * 1.05em);
    font-family: var(--font-body);
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    padding-bottom: 0.08em; /* room for the italic descenders */
  }
  @media (min-width: 640px) {
    .kbi-head { min-height: calc(2 * 1.05em); }
  }
  .kbi-slot {
    grid-area: 1 / 1;
  }
  /* The accent line; JS builds the later ones, so they carry no scoping attribute. */
  .kbi-slot :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  /* Reserved lines keep the keyboard from jumping as stories change length. */
  .kbi-story {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    min-height: calc(1.5em * 3);
  }
  @media (min-width: 640px) {
    .kbi-story { min-height: calc(1.5em * 2); }
  }
  /* The link's display is set here, so the `hidden` attribute has to be restated to win over it. */
  .kbi-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  .kbi-jump[hidden] {
    display: none;
  }

  /* ---------- Keyboard ---------- */
  .kbi-wrap {
    container-type: inline-size;
    display: grid;
    flex: 1;
    place-items: center;
    width: 100%;
    padding-block: 1.75rem 1.25rem;
  }
  .kbi-board {
    --outline: #16161D;
    /* One key unit: fits the width, and leaves room for the headline above and the ticker below. */
    --u: max(40px, min(140px, calc(100cqw / 6.4), calc((100svh - 34rem) / 2.15)));
    --line: max(2px, calc(var(--u) * 0.022));
    position: relative;
    width: calc(var(--u) * var(--kw));
    height: calc(var(--u) * var(--kh));
    touch-action: none;
  }

  .kbi-key {
    position: absolute;
    left: calc(var(--u) * var(--x));
    top: calc(var(--u) * var(--y));
    width: calc(var(--u) * var(--w));
    height: calc(var(--u) * var(--h));
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .kbi-key:focus {
    outline: none;
  }
  /* The empty spot on the paper, revealed when a cap is pulled off */
  .kbi-key::before {
    content: '';
    position: absolute;
    inset: calc(var(--u) * 0.1);
    border: var(--line) dashed rgb(22 22 29 / 0.22);
    border-radius: calc(var(--u) * 0.16);
    background: rgb(22 22 29 / 0.05);
  }
  /* While its cap is in hand, the spot marks where it goes back */
  .kbi-key[data-dragging]::before {
    border-style: solid;
    border-color: var(--ink);
  }
  .kbi-stem {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--u) * 0.28);
    height: calc(var(--u) * 0.28);
    margin: calc(var(--u) * -0.14) 0 0 calc(var(--u) * -0.14);
  }
  .kbi-stem::before,
  .kbi-stem::after {
    content: '';
    position: absolute;
    background: var(--side);
    border-radius: 1px;
  }
  .kbi-stem::before { left: 38%; right: 38%; top: 0; bottom: 0; }
  .kbi-stem::after { top: 38%; bottom: 38%; left: 0; right: 0; }

  /* The whole cap: a chunky, outlined body whose darker side wall shows below the top face */
  .kbi-shell {
    position: absolute;
    inset: calc(var(--u) * 0.03);
    overflow: hidden;
    border: var(--line) solid var(--outline);
    border-radius: calc(var(--u) * 0.17);
    background: linear-gradient(180deg, var(--side) 55%, color-mix(in oklab, var(--side) 82%, #000));
    box-shadow: 0 calc(var(--u) * 0.05) calc(var(--u) * 0.1) rgb(22 22 29 / 0.18);
  }
  /* Bevel edges running from the top face down to the bottom corners */
  .kbi-shell::before,
  .kbi-shell::after {
    content: '';
    position: absolute;
    bottom: calc(var(--u) * 0.19);
    width: calc(var(--u) * 0.18);
    height: var(--line);
    background: var(--outline);
  }
  .kbi-shell::before {
    left: calc(var(--u) * -0.07);
    transform-origin: right center;
    transform: rotate(-55deg);
  }
  .kbi-shell::after {
    right: calc(var(--u) * -0.07);
    transform-origin: left center;
    transform: rotate(55deg);
  }
  .kbi-top {
    position: absolute;
    top: calc(var(--u) * 0.035);
    left: calc(var(--u) * 0.07);
    right: calc(var(--u) * 0.07);
    bottom: calc(var(--u) * 0.2);
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--u) * 0.04) calc(var(--u) * 0.05) calc(var(--u) * 0.07);
    overflow: hidden;
    border: var(--line) solid var(--outline);
    border-radius: calc(var(--u) * 0.13);
    background: var(--cap);
    color: var(--outline);
    box-shadow: inset 0 calc(var(--u) * 0.02) 0 rgb(255 255 255 / 0.35);
  }
  .kbi-legend {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: calc(var(--u) * 0.44);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .kbi-sub {
    display: -webkit-box;
    flex-shrink: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: max(8px, calc(var(--u) * 0.062));
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---------- Enter: an ISO (inverted L) cap, drawn in SVG so outline, wall and face follow the L ---------- */
  .kbi-key[data-enter]::before {
    display: none;
  }
  .kbi-enter-socket,
  .kbi-enter-body {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .kbi-enter-socket path {
    fill: rgb(22 22 29 / 0.05);
    stroke: rgb(22 22 29 / 0.22);
    stroke-width: var(--line);
    stroke-dasharray: 6 4;
    vector-effect: non-scaling-stroke;
  }
  .kbi-key[data-enter][data-dragging] .kbi-enter-socket path {
    stroke: var(--ink);
    stroke-dasharray: none;
  }
  /* The shell is just the draggable frame here; only the painted L takes the pointer. */
  .kbi-key[data-enter] .kbi-shell {
    inset: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    pointer-events: none;
  }
  .kbi-key[data-enter] .kbi-shell::before,
  .kbi-key[data-enter] .kbi-shell::after {
    display: none;
  }
  .kbi-enter-body {
    filter: drop-shadow(0 calc(var(--u) * 0.05) calc(var(--u) * 0.05) rgb(22 22 29 / 0.18));
  }
  .kbi-side-top { stop-color: var(--side); }
  .kbi-side-bottom { stop-color: color-mix(in oklab, var(--side) 82%, #000); }
  .kbi-enter-shape,
  .kbi-enter-bevel,
  .kbi-enter-face path {
    stroke: var(--outline);
    stroke-width: var(--line);
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .kbi-enter-shape,
  .kbi-enter-face path {
    pointer-events: auto;
  }
  .kbi-enter-bevel {
    fill: none;
  }
  .kbi-enter-face path {
    fill: var(--cap);
  }
  /* Current / focus ring traces the L instead of a rectangle over the neighbouring O */
  .kbi-enter-ring {
    fill: none;
    stroke: transparent;
    stroke-width: 3px;
    vector-effect: non-scaling-stroke;
  }
  .kbi-key[data-enter][data-current] .kbi-shell,
  .kbi-key[data-enter]:focus-visible .kbi-shell {
    outline: none;
  }
  .kbi-key[data-enter][data-current] .kbi-enter-ring {
    stroke: var(--ink);
  }
  .kbi-key[data-enter]:focus-visible .kbi-enter-ring {
    stroke: var(--color-stage-accent);
  }
  /* The moving top face: sized like a letter's, so a press sinks it just as deep; the L face hangs below it. */
  .kbi-key[data-enter] .kbi-top {
    top: calc(var(--u) * 0.065);
    left: calc(var(--u) * 0.1);
    right: calc(var(--u) * 0.1);
    bottom: auto;
    display: block;
    height: calc(var(--u) * 0.785);
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    pointer-events: none;
  }
  .kbi-enter-face {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--u) * 1.35);
    height: calc(var(--u) * 1.705);
    overflow: visible;
  }
  .kbi-enter-icon {
    position: relative;
    display: block;
    width: calc(var(--u) * 0.42);
    height: calc(var(--u) * 0.42);
    margin: calc(var(--u) * 0.14) 0 0 calc(var(--u) * 0.22);
  }
  .kbi-key[data-enter] .kbi-sub {
    position: absolute;
    top: calc(var(--u) * 0.98);
    right: calc(var(--u) * 0.1);
    display: block;
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-size: max(8px, calc(var(--u) * 0.075));
  }

  /* States */
  .kbi-key[data-visited] .kbi-top::after {
    content: '';
    position: absolute;
    top: calc(var(--u) * 0.06);
    right: calc(var(--u) * 0.07);
    width: max(4px, calc(var(--u) * 0.05));
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .kbi-key[data-current] .kbi-shell {
    outline: 3px solid var(--ink);
    outline-offset: max(2px, calc(var(--u) * 0.04));
  }
  .kbi-key:focus-visible .kbi-shell {
    outline: 3px solid var(--color-stage-accent);
    outline-offset: max(2px, calc(var(--u) * 0.04));
  }
  .kbi-key[data-lit] .kbi-top {
    filter: brightness(0.92);
  }

  /* Small keyboards (phones): the legend only, centred */
  @container (width < 560px) {
    .kbi-sub { display: none; }
    .kbi-top { justify-content: center; }
  }

  /* ---------- Ticker ---------- */
  .kbi-marquee {
    overflow: hidden;
    padding-block: 0.7rem;
    border: 1px solid #C9C2F0;
    border-radius: 9999px;
    background: #DAD5F6;
    color: var(--outline, #16161D);
  }
  .kbi-marquee-track {
    display: flex;
    width: max-content;
    animation: kbi-marquee 48s linear infinite;
  }
  .kbi-marquee:hover .kbi-marquee-track {
    animation-play-state: paused;
  }
  .kbi-marquee-copy {
    display: flex;
    flex-shrink: 0;
  }
  .kbi-marquee-copy > span {
    padding-left: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .kbi-marquee-copy > span::after {
    content: '·';
    padding-left: 1.5rem;
  }
  @keyframes kbi-marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kbi-marquee-track { animation: none; }
  }

  /* Labels rising from the keys */
  .kbi-fly {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    color: var(--ink, #16161D);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';
  import { InertiaPlugin } from 'gsap/InertiaPlugin';
  import { keys } from '../data/keyboard';
  import type { LetterKey } from '../data/keyboard';

  gsap.registerPlugin(Draggable, InertiaPlugin);

  const PRESS_DEPTH = 10; // yPercent of the top face
  const WAVE_DEPTH = 6;
  const WAVE_RADIUS = 1.6; // key units: direct neighbours only
  const WAVE_STEP = 0.04; // seconds of delay per key unit
  const SETTLE_MS = 150; // stillness before a swept key tells its full story
  const TIP_AFTER = 5;
  const MAX_TILT = 14;
  const SOCKET_PULL = 0.6; // snap radius around a socket, as a fraction of the cap width
  const TIP_PULL = 'Tip: you can pull the keycaps off – grab one and drag it.';
  const TIP_RETURN = 'Tip: drag the keycap back to its spot – the socket pulls it in.';

  interface Motion {
    reduce: boolean;
  }

  interface DragHooks {
    onPull: (cap: Keycap) => void;
    onDrop: (cap: Keycap) => void;
    /** The cap stopped moving; `seated` is true when it ended up back in its socket. */
    onRest: (cap: Keycap, seated: boolean) => void;
  }

  /* ---------- One physical key ---------- */

  class Keycap {
    readonly shell: HTMLElement;
    readonly top: HTMLElement;
    neighbours: { cap: Keycap; distance: number }[] = [];
    held = false;
    private draggable?: Draggable;
    private hooks?: DragHooks;
    private tilt?: (value: number) => void;

    constructor(
      readonly def: LetterKey,
      readonly el: HTMLButtonElement,
      private readonly motion: Motion,
    ) {
      this.shell = el.querySelector<HTMLElement>('[data-shell]')!;
      this.top = el.querySelector<HTMLElement>('[data-top]')!;
    }

    get center() {
      return { x: this.def.x + this.def.w / 2, y: this.def.y + this.def.h / 2 };
    }

    get pulled() {
      return Number(gsap.getProperty(this.shell, 'x')) !== 0 || Number(gsap.getProperty(this.shell, 'y')) !== 0;
    }

    /** Quick down-and-up, as if the key was struck. */
    tap(depth = PRESS_DEPTH) {
      if (this.motion.reduce) return this.flash();
      gsap.killTweensOf(this.top);
      gsap
        .timeline()
        .to(this.top, { yPercent: depth, duration: 0.06, ease: 'power2.out' })
        .to(this.top, { yPercent: 0, duration: 0.42, ease: 'back.out(3)' });
    }

    hold() {
      this.held = true;
      if (this.motion.reduce) return this.el.setAttribute('data-lit', '');
      gsap.killTweensOf(this.top);
      gsap.to(this.top, { yPercent: PRESS_DEPTH, duration: 0.06, ease: 'power2.out' });
    }

    release() {
      this.held = false;
      if (this.motion.reduce) return this.el.removeAttribute('data-lit');
      gsap.to(this.top, { yPercent: 0, duration: 0.42, ease: 'back.out(3)' });
    }

    /** Small sympathetic dip when a neighbouring key is struck. */
    nudge(depth: number, delay: number) {
      if (this.held) return;
      gsap.killTweensOf(this.top);
      gsap
        .timeline({ delay })
        .to(this.top, { yPercent: depth, duration: 0.08, ease: 'power1.out' })
        .to(this.top, { yPercent: 0, duration: 0.24, ease: 'power2.out' });
    }

    flash() {
      this.el.setAttribute('data-lit', '');
      window.setTimeout(() => this.el.removeAttribute('data-lit'), 160);
    }

    setCurrent(current: boolean) {
      this.el.toggleAttribute('data-current', current);
    }

    markVisited() {
      this.el.setAttribute('data-visited', '');
    }

    enableDrag(bounds: HTMLElement, hooks: DragHooks) {
      const cap = this;
      this.hooks = hooks;
      this.tilt = gsap.quickTo(this.shell, 'rotation', { duration: 0.45, ease: 'power3.out' });
      // The socket is magnetic: near home, the cap snaps in while dragging (liveSnap) and when a throw lands.
      const homeSnap = (point: { x: number; y: number }) =>
        Math.hypot(point.x, point.y) < this.shell.offsetWidth * SOCKET_PULL ? { x: 0, y: 0 } : point;
      [this.draggable] = Draggable.create(this.shell, {
        type: 'x,y',
        bounds,
        inertia: !this.motion.reduce,
        snap: { points: homeSnap },
        liveSnap: true,
        minimumMovement: 8,
        edgeResistance: 0.8,
        zIndexBoost: true,
        cursor: 'pointer',
        activeCursor: 'grabbing',
        onDragStart() {
          cap.el.setAttribute('data-dragging', '');
          hooks.onPull(cap);
          gsap.to(cap.shell, { scale: 1.12, duration: cap.motion.reduce ? 0 : 0.2, ease: 'power3.out' });
        },
        onDrag: () => this.lean(),
        onThrowUpdate: () => this.lean(),
        onDragEnd() {
          hooks.onDrop(cap);
          // Released over its socket: drop it in, even if the hand was still moving.
          if (!cap.pulled) {
            this.tween?.kill();
            return cap.seat();
          }
          if (!this.isThrowing) cap.land();
        },
        onThrowComplete: () => this.land(),
      });
    }

    disableDrag() {
      this.draggable?.kill();
      this.draggable = undefined;
      this.hooks = undefined;
      this.el.removeAttribute('data-dragging');
      gsap.set(this.shell, { clearProps: 'x,y,rotation,scale,zIndex' });
    }

    putBack(delay = 0) {
      return gsap.to(this.shell, {
        x: 0,
        y: 0,
        rotation: 0,
        scale: 1,
        delay: this.motion.reduce ? 0 : delay,
        duration: this.motion.reduce ? 0 : 0.7,
        ease: 'power3.inOut',
        onComplete: () => this.seat(),
      });
    }

    private lean() {
      if (this.motion.reduce || !this.tilt) return;
      // Straighten up while hovering over the socket, so the cap visibly lines up with it.
      if (!this.pulled) return this.tilt(0);
      const vx = InertiaPlugin.getVelocity(this.shell, 'x') || 0;
      this.tilt(gsap.utils.clamp(-MAX_TILT, MAX_TILT, vx / 90));
    }

    /** Wherever the cap comes to rest: back in its socket, or somewhere on the stage. */
    private land() {
      if (!this.pulled) return this.seat();
      this.el.removeAttribute('data-dragging');
      if (this.motion.reduce) gsap.set(this.shell, { scale: 1 });
      else {
        this.tilt?.(gsap.utils.random(-6, 6));
        gsap.to(this.shell, { scale: 1, duration: 0.3, ease: 'power2.out' });
      }
      this.hooks?.onRest(this, false);
    }

    /** Clicks the cap back onto its switch. */
    private seat() {
      this.el.removeAttribute('data-dragging');
      gsap.killTweensOf(this.shell, 'rotation,scale');
      gsap.to(this.shell, {
        rotation: 0,
        scale: 1,
        duration: this.motion.reduce ? 0 : 0.15,
        ease: 'power2.out',
        onComplete: () => gsap.set(this.shell, { zIndex: 'auto' }),
      });
      this.draggable?.update();
      this.tap(6);
      this.hooks?.onRest(this, true);
    }
  }

  /* ---------- The headline and story above the keyboard ---------- */

  class StoryScreen {
    private readonly slots: HTMLElement[];
    private readonly story: HTMLElement;
    private readonly live: HTMLElement;
    private readonly jump: HTMLAnchorElement;
    private readonly jumpTerm: HTMLElement;
    private readonly flyers: HTMLElement[];
    private readonly flyLayer: HTMLElement;
    private slotIndex = 0;
    private flyIndex = 0;
    private shownId = '';

    constructor(
      root: HTMLElement,
      private readonly motion: Motion,
    ) {
      this.slots = [...root.querySelectorAll<HTMLElement>('[data-kbi-head]')];
      this.story = root.querySelector('[data-kbi-story]')!;
      this.live = root.querySelector('[data-kbi-live]')!;
      this.jump = root.querySelector('[data-kbi-jump]')!;
      this.jumpTerm = root.querySelector('[data-kbi-jump-term]')!;
      this.flyLayer = root.querySelector('[data-kbi-flylayer]')!;
      this.flyers = [...this.flyLayer.querySelectorAll<HTMLElement>('.kbi-fly')];
    }

    /** Fast feedback while sweeping: the headline changes, the story waits. */
    preview(cap: Keycap) {
      this.swapHead(cap.def);
      this.fly(cap);
    }

    /** Full story and the way down to its section, once the visitor settles on a key. */
    tell(cap: Keycap, { fly }: { fly: boolean }) {
      const { def } = cap;
      this.swapHead(def);
      if (fly) this.fly(cap);
      this.setStory(def.story);
      this.setJump(def);
      this.live.textContent = `${def.lead} ${def.term}. ${def.story}`;
    }

    /** The topic's own section once it exists; until then the closest existing one. */
    private setJump(def: LetterKey) {
      const id = document.getElementById(def.target) ? def.target : def.fallback;
      const label = def.term.charAt(0).toUpperCase() + def.term.slice(1);
      this.jump.href = `#${id}`;
      this.jump.setAttribute('aria-label', `Jump to ${label}`);
      this.jumpTerm.textContent = label;
      this.jump.hidden = false;
    }

    private setStory(text: string) {
      if (this.story.textContent === text) return;
      this.story.textContent = text;
      if (this.motion.reduce) return;
      gsap.fromTo(this.story, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.28, ease: 'power2.out', overwrite: true });
    }

    /** "P is for" over an italic "Projects.", slid in over the previous headline. */
    private swapHead(def: LetterKey) {
      if (def.id === this.shownId) return;
      this.shownId = def.id;
      const outgoing = this.slots[this.slotIndex];
      this.slotIndex = 1 - this.slotIndex;
      const incoming = this.slots[this.slotIndex];

      const lead = document.createElement('span');
      lead.className = 'block';
      lead.textContent = def.lead;
      const term = document.createElement('em');
      term.style.color = def.ink;
      term.textContent = def.term;
      const line = document.createElement('span');
      line.className = 'block';
      line.append(term, '.');
      incoming.replaceChildren(lead, line);

      if (this.motion.reduce) {
        gsap.set(outgoing, { autoAlpha: 0 });
        gsap.set(incoming, { autoAlpha: 1, yPercent: 0 });
        return;
      }
      gsap.to(outgoing, { yPercent: -100, autoAlpha: 0, duration: 0.22, ease: 'power2.in', overwrite: true });
      gsap.fromTo(
        incoming,
        { yPercent: 100, autoAlpha: 1 },
        { yPercent: 0, duration: 0.32, ease: 'power3.out', overwrite: true },
      );
    }

    /** A small label rises out of the struck key. */
    private fly(cap: Keycap) {
      if (this.motion.reduce) return;
      const label = this.flyers[this.flyIndex];
      this.flyIndex = (this.flyIndex + 1) % this.flyers.length;
      const layer = this.flyLayer.getBoundingClientRect();
      const key = cap.shell.getBoundingClientRect();
      label.textContent = cap.def.term;
      label.style.setProperty('--ink', cap.def.ink);
      const x = key.left - layer.left + key.width / 2;
      const y = key.top - layer.top;
      gsap.killTweensOf(label);
      gsap.set(label, { x, y, xPercent: -50, yPercent: -100, autoAlpha: 1 });
      gsap.to(label, { y: y - 46, autoAlpha: 0, duration: 0.9, ease: 'power2.out' });
    }
  }

  /* ---------- "Tell me more": the letters in word order, then Enter ---------- */

  class Tour {
    private position = -1;

    step(direction: 1 | -1) {
      this.position = (this.position + direction + keys.length) % keys.length;
      return keys[this.position].id;
    }

    sync(id: string) {
      const index = keys.findIndex((key) => key.id === id);
      if (index !== -1) this.position = index;
    }
  }

  /* ---------- Orchestration ---------- */

  class KeyboardIntro {
    private readonly caps: Keycap[];
    private readonly byId = new Map<string, Keycap>();
    /** Upper-cased `KeyboardEvent.key` → the caps it can press (three for O). */
    private readonly byMatch = new Map<string, Keycap[]>();
    /** Physical key (`KeyboardEvent.code`) → the cap it pressed, so keyup releases the same one. */
    private readonly heldByCode = new Map<string, Keycap>();
    private readonly screen: StoryScreen;
    private readonly tour = new Tour();
    private readonly board: HTMLElement;
    private current?: Keycap;
    private lastSwept?: Keycap;
    private settleTimer = 0;
    private presses = 0;
    private dragging = false;
    private inView = false;
    private readonly visited = new Set<string>();

    constructor(
      private readonly root: HTMLElement,
      private readonly motion: Motion,
      private readonly canPull: boolean,
    ) {
      this.board = root.querySelector('[data-kbi-board]')!;
      this.screen = new StoryScreen(root, motion);
      this.caps = keys.map((def) => {
        const el = this.board.querySelector<HTMLButtonElement>(`[data-key="${CSS.escape(def.id)}"]`)!;
        return new Keycap(def, el, motion);
      });
      for (const cap of this.caps) {
        this.byId.set(cap.def.id, cap);
        this.byMatch.set(cap.def.match, [...(this.byMatch.get(cap.def.match) ?? []), cap]);
      }
      this.computeNeighbours();
    }

    private readonly cleanups: (() => void)[] = [];

    mount() {
      this.listen(this.board, 'pointermove', (e) => this.onSweep(e as PointerEvent));
      this.listen(this.board, 'pointerleave', () => (this.lastSwept = undefined));
      this.listen(this.board, 'click', (e) => this.onClick(e as MouseEvent));
      this.listen(this.board, 'dblclick', (e) => this.onDoubleClick(e as MouseEvent));
      this.listen(this.board, 'keydown', (e) => this.onBoardKey(e as KeyboardEvent));
      this.listen(window, 'keydown', (e) => this.onPhysical(e as KeyboardEvent, true));
      this.listen(window, 'keyup', (e) => this.onPhysical(e as KeyboardEvent, false));
      this.listen(window, 'blur', () => this.releaseAll());

      this.listen(this.root.querySelector('[data-kbi-next]')!, 'click', () => this.step(1));
      this.listen(this.root.querySelector('[data-kbi-prev]')!, 'click', () => this.step(-1));
      this.listen(this.root.querySelector('[data-kbi-putback]')!, 'click', () => this.putBackAll());

      const io = new IntersectionObserver(([entry]) => (this.inView = entry.isIntersecting), { threshold: 0.5 });
      io.observe(this.board);
      this.cleanups.push(() => io.disconnect());

      if (this.canPull) {
        for (const cap of this.caps) {
          cap.enableDrag(this.root, {
            onPull: () => {
              this.dragging = true;
              this.lastSwept = undefined;
              this.revealTip(TIP_RETURN);
            },
            onDrop: () => {
              this.dragging = false;
            },
            onRest: (rested, seated) => {
              if (seated) this.ripple(rested);
              this.updatePutBack();
            },
          });
        }
      }
    }

    /** Runs when a media condition flips; the next instance starts from a clean board. */
    destroy() {
      window.clearTimeout(this.settleTimer);
      this.cleanups.forEach((fn) => fn());
      this.cleanups.length = 0;
      this.heldByCode.clear();
      for (const cap of this.caps) {
        cap.disableDrag();
        cap.held = false;
        gsap.set(cap.top, { clearProps: 'transform' });
        cap.el.removeAttribute('data-visited');
        cap.el.removeAttribute('data-current');
        cap.el.removeAttribute('data-lit');
      }
      this.visited.clear();
      this.updateCounter();
      this.updatePutBack();
      this.root.querySelector<HTMLElement>('[data-kbi-hint]')!.hidden = false;
      this.root.querySelector<HTMLElement>('[data-kbi-tip]')!.hidden = true;
    }

    private listen(target: EventTarget, type: string, handler: (e: Event) => void) {
      target.addEventListener(type, handler);
      this.cleanups.push(() => target.removeEventListener(type, handler));
    }

    /* Input handlers */

    private onSweep(e: PointerEvent) {
      if (this.dragging) return;
      // Touch pointers are captured by the first key, so resolve the key under the finger ourselves.
      const hit = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>('[data-key]');
      const cap = hit ? this.byId.get(hit.dataset.key!) : undefined;
      if (!cap || cap === this.lastSwept) return;
      this.lastSwept = cap;
      cap.tap();
      this.ripple(cap);
      this.screen.preview(cap);
      this.visit(cap);
      window.clearTimeout(this.settleTimer);
      this.settleTimer = window.setTimeout(() => this.select(cap, { fly: false }), SETTLE_MS);
    }

    private onClick(e: MouseEvent) {
      const hit = (e.target as HTMLElement).closest<HTMLElement>('[data-key]');
      const cap = hit && this.byId.get(hit.dataset.key!);
      if (cap) this.activate(cap);
    }

    private onDoubleClick(e: MouseEvent) {
      const hit = (e.target as HTMLElement).closest<HTMLElement>('[data-key]');
      const cap = hit && this.byId.get(hit.dataset.key!);
      if (cap?.pulled) cap.putBack();
    }

    /** Roving focus: arrows move between keys like on a real board. */
    private onBoardKey(e: KeyboardEvent) {
      const from = this.byId.get((e.target as HTMLElement).closest<HTMLElement>('[data-key]')?.dataset.key ?? '');
      if (!from) return;
      const dir = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];
      if (!dir) return;
      e.preventDefault();
      e.stopPropagation();
      const to = this.nearest(from, dir[0], dir[1]);
      if (!to) return;
      from.el.tabIndex = -1;
      to.el.tabIndex = 0;
      to.el.focus();
    }

    /** Mirror the visitor's real keyboard while the intro is on screen. */
    private onPhysical(e: KeyboardEvent, down: boolean) {
      if (!down) {
        const held = this.heldByCode.get(e.code);
        if (!held) return;
        this.heldByCode.delete(e.code);
        held.release();
        return;
      }
      if (!this.inView || e.isComposing || e.repeat || e.ctrlKey || e.metaKey || e.altKey) return;
      const target = e.target instanceof Element ? e.target : null;
      if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
      // Enter on a focused control keeps its native meaning (pressing that button or link).
      if (e.key === 'Enter' && target?.closest('button, a')) return;
      const cap = this.nextFor(e.key.toUpperCase());
      if (!cap) return;
      this.heldByCode.get(e.code)?.release();
      this.heldByCode.set(e.code, cap);
      cap.hold();
      this.ripple(cap);
      this.select(cap, { fly: true });
      this.tour.sync(cap.def.id);
    }

    /** The word has three O's: typing moves forward through it, so "portfolio" lights the keys in order. */
    private nextFor(match: string) {
      const candidates = this.byMatch.get(match);
      if (!candidates) return undefined;
      const after = this.current ? this.caps.indexOf(this.current) : -1;
      return candidates.find((cap) => this.caps.indexOf(cap) > after) ?? candidates[0];
    }

    private releaseAll() {
      this.heldByCode.clear();
      this.caps.forEach((cap) => cap.held && cap.release());
    }

    /* Actions */

    /** A deliberate press: click, tap or the tour. */
    private activate(cap: Keycap) {
      window.clearTimeout(this.settleTimer);
      cap.tap(PRESS_DEPTH * 1.3);
      this.ripple(cap);
      this.select(cap, { fly: true });
      this.tour.sync(cap.def.id);
    }

    private step(direction: 1 | -1) {
      this.activate(this.byId.get(this.tour.step(direction))!);
    }

    private select(cap: Keycap, { fly }: { fly: boolean }) {
      this.current?.setCurrent(false);
      this.current = cap;
      cap.setCurrent(true);
      this.screen.tell(cap, { fly });
      this.visit(cap);
      this.presses += 1;
      if (this.canPull && this.presses === TIP_AFTER) this.revealTip();
    }

    private visit(cap: Keycap) {
      if (this.visited.has(cap.def.id)) return;
      this.visited.add(cap.def.id);
      cap.markVisited();
      this.updateCounter();
    }

    private ripple(origin: Keycap) {
      if (this.motion.reduce) return;
      for (const { cap, distance } of origin.neighbours) {
        cap.nudge(WAVE_DEPTH * (1 - distance / WAVE_RADIUS), distance * WAVE_STEP);
      }
    }

    private putBackAll() {
      this.caps.filter((c) => c.pulled).forEach((cap, i) => cap.putBack(i * 0.035));
    }

    private updatePutBack() {
      const button = this.root.querySelector<HTMLButtonElement>('[data-kbi-putback]')!;
      button.hidden = !this.caps.some((c) => c.pulled);
    }

    /** The tip takes the place of the first-time hint: same spot, next level. */
    private revealTip(text = TIP_PULL) {
      const tip = this.root.querySelector<HTMLElement>('[data-kbi-tip]')!;
      if (!tip.hidden && tip.textContent === text) return;
      this.root.querySelector<HTMLElement>('[data-kbi-hint]')!.hidden = true;
      tip.textContent = text;
      tip.hidden = false;
      if (!this.motion.reduce) gsap.from(tip, { autoAlpha: 0, y: 6, duration: 0.4, ease: 'power2.out' });
    }

    private updateCounter() {
      this.root.querySelector('[data-kbi-count]')!.textContent = String(this.visited.size);
    }

    /* Geometry helpers (key units, straight from the layout data) */

    private computeNeighbours() {
      for (const cap of this.caps) {
        const c = cap.center;
        cap.neighbours = this.caps
          .filter((other) => other !== cap)
          .map((other) => ({ cap: other, distance: Math.hypot(other.center.x - c.x, other.center.y - c.y) }))
          .filter((n) => n.distance <= WAVE_RADIUS)
          .sort((a, b) => a.distance - b.distance);
      }
    }

    private nearest(from: Keycap, dx: number, dy: number) {
      const c = from.center;
      let best: Keycap | undefined;
      let bestScore = Infinity;
      for (const cap of this.caps) {
        if (cap === from) continue;
        const ox = cap.center.x - c.x;
        const oy = cap.center.y - c.y;
        const along = ox * dx + oy * dy;
        if (along <= 0.1) continue;
        const across = Math.abs(ox * dy - oy * dx);
        const score = along + across * 3;
        if (score < bestScore) {
          bestScore = score;
          best = cap;
        }
      }
      return best;
    }
  }

  /* ---------- Boot ---------- */

  const root = document.querySelector<HTMLElement>('[data-kbi]');
  if (root) {
    gsap.matchMedia().add(
      {
        always: '(min-width: 0px)',
        fine: '(pointer: fine)',
        reduce: '(prefers-reduced-motion: reduce)',
      },
      (ctx) => {
        const { fine, reduce } = ctx.conditions as { fine: boolean; reduce: boolean };
        const keyboard = new KeyboardIntro(root, { reduce }, fine);
        keyboard.mount();
        return () => keyboard.destroy();
      },
    );
  }
</script>
