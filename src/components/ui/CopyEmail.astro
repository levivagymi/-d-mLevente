---
// The email address as a mailto link plus a Copy button: recruiters paste it into an ATS or a mail client.
// If the Clipboard API is unavailable or refused, the address is selected so Ctrl/⌘+C still works.
import { person, mailto } from '../../data/profile';

interface Props {
  tone?: 'page' | 'band';
  size?: 'sm' | 'lg';
  subject?: string;
  class?: string;
}

const { tone = 'page', size = 'sm', subject = 'Internship – Ádám Levente', class: className } = Astro.props;
const band = tone === 'band';
---

<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-2', className]} data-copy-root>
  <a
    href={mailto(subject)}
    class:list={[
      'break-all font-bold underline-offset-4 transition-colors duration-150 ease-out hover:underline',
      size === 'lg' ? 'text-display' : 'text-body',
      band ? 'text-inv-fg hover:text-inv-accent' : 'text-fg hover:text-accent',
    ]}
    data-copy-text>{person.email}</a
  >
  <button
    type="button"
    class:list={[
      'inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border bg-transparent px-4 font-mono text-label uppercase',
      'transition-[color,background-color,border-color,transform] duration-150 ease-out active:translate-y-px motion-reduce:active:translate-y-0',
      band ? 'border-inv-line text-inv-fg hover:border-inv-fg' : 'border-line text-fg hover:border-line-strong',
    ]}
    aria-label={`Copy ${person.email}`}
    data-copy={person.email}
  >
    <span data-copy-label>Copy</span>
  </button>
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  const RESET_AFTER_MS = 2000;
  const copyKeys = /Mac|iPhone|iPad/.test(navigator.userAgent) ? '⌘C' : 'Ctrl+C';

  function selectText(element: Element) {
    const range = document.createRange();
    range.selectNodeContents(element);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-copy-root]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-copy]');
    const label = root.querySelector<HTMLElement>('[data-copy-label]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    const text = root.querySelector<HTMLElement>('[data-copy-text]');
    if (!button || !label || !status || !text) continue;

    let resetTimer: number | undefined;
    button.addEventListener('click', async () => {
      const value = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
        label.textContent = 'Copied ✓';
        status.textContent = 'Email address copied.';
      } catch {
        // No clipboard access (insecure context, permission refused): hand the copy over to the visitor.
        selectText(text);
        label.textContent = `Press ${copyKeys}`;
        status.textContent = `Couldn't copy automatically. The address is selected; press ${copyKeys}.`;
      }
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = 'Copy';
        status.textContent = '';
      }, RESET_AFTER_MS);
    });
  }
</script>
