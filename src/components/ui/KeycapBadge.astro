---
// A tiny copy of a PORTFOLIO keycap, in its own colours, that marks where each letter's anchor lives.
import { keycap } from '../../data/sections';

interface Props {
  /** Keycap id from src/data/keyboard.ts: "P", "O1", "Enter", … */
  id: string;
}

const key = keycap(Astro.props.id);
---

<span class="keycap" style={`--cap:${key.cap};--side:${key.side}`} aria-hidden="true">{key.legend}</span>

<style>
  .keycap {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.3rem 2px;
    border-radius: 5px;
    background: var(--cap);
    box-shadow: inset 0 -2px 0 var(--side);
    /* Ink on every pastel cap clears 7.5:1, in either theme. */
    color: #16161d;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    font-style: normal;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
  }
</style>
