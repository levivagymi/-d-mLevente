---
---

<section class="section" id="experience" aria-labelledby="exp-heading">
  <div class="container">
    <div class="section-header reveal-blur">
      <div class="section-tag">Experience</div>
      <h2 id="exp-heading" class="section-title">
        What I’ve <span>done so far</span>
      </h2>
    </div>

    <div class="portfolio__grid">
      <article class="portfolio-card reveal-scale cin-delay-1">
        <div class="portfolio-card__image" role="img" aria-label="Freelance web development">
          <span style="font-family:var(--font-display);font-size:2rem;font-weight:900;color:var(--text-muted);opacity:0.35;letter-spacing:-0.05em;">01</span>
        </div>
        <div class="portfolio-card__body">
          <h3 class="portfolio-card__title">Freelance web development</h3>
          <p class="portfolio-card__desc">
            Laguna Lovasklub — designing, building and launching a complete website.
            Frontend, backend (Supabase), deployment on Vercel. Delivered on my own, from the first brief to handover.
          </p>
          <div class="portfolio-card__tech">
            <span class="badge">JavaScript</span>
            <span class="badge">Supabase</span>
            <span class="badge">Vercel</span>
          </div>
          <span class="portfolio-card__link" style="color:var(--accent);cursor:default;">2022 – present</span>
        </div>
      </article>

      <article class="portfolio-card reveal-scale cin-delay-2">
        <div class="portfolio-card__image" role="img" aria-label="Personal projects">
          <span style="font-family:var(--font-display);font-size:2rem;font-weight:900;color:var(--text-muted);opacity:0.35;letter-spacing:-0.05em;">02</span>
        </div>
        <div class="portfolio-card__body">
          <h3 class="portfolio-card__title">Personal & school projects</h3>
          <p class="portfolio-card__desc">
            Several full-stack web applications — frontend, database, deployment.
            Version control, iterative development, AI-assisted coding workflows.
          </p>
          <div class="portfolio-card__tech">
            <span class="badge">Python</span>
            <span class="badge">Java</span>
            <span class="badge">SQL</span>
            <span class="badge">Git</span>
          </div>
          <span class="portfolio-card__link" style="color:var(--accent);cursor:default;">Full-stack projects</span>
        </div>
      </article>

      <article class="portfolio-card reveal-scale cin-delay-3">
        <div class="portfolio-card__image" role="img" aria-label="Testing">
          <span style="font-family:var(--font-display);font-size:2rem;font-weight:900;color:var(--text-muted);opacity:0.35;letter-spacing:-0.05em;">03</span>
        </div>
        <div class="portfolio-card__body">
          <h3 class="portfolio-card__title">Software testing</h3>
          <p class="portfolio-card__desc">
            Functional and manual testing, writing test cases, reproducing
            and documenting bugs. Quality assurance is an integral part of development.
          </p>
          <div class="portfolio-card__tech">
            <span class="badge">Test documentation</span>
            <span class="badge">Bug tracking</span>
            <span class="badge">QA</span>
          </div>
          <span class="portfolio-card__link" style="color:var(--accent);cursor:default;">Specialization: testing</span>
        </div>
      </article>

      <article class="portfolio-card reveal-scale cin-delay-4">
        <div class="portfolio-card__image" role="img" aria-label="Education">
          <span style="font-family:var(--font-display);font-size:2rem;font-weight:900;color:var(--text-muted);opacity:0.35;letter-spacing:-0.05em;">04</span>
        </div>
        <div class="portfolio-card__body">
          <h3 class="portfolio-card__title">Education</h3>
          <p class="portfolio-card__desc">
            TSZC Bánki Donát – Péch Antal Technical School. IT and telecommunications track,
            specializing in software development and testing.
          </p>
          <div class="portfolio-card__tech">
            <span class="badge">IT</span>
            <span class="badge">Year 5</span>
          </div>
          <span class="portfolio-card__link" style="color:var(--accent);cursor:default;">Final-year student</span>
        </div>
      </article>
    </div>
  </div>
</section>
